charge = -1		# doc: Particle charge. electrons = -1, source: /home/mike/work/cases/perftests/hermes-perftest/test4steady/BOUT.inp
conduction_collisions_mode = braginskii		# type: string, doc: Can be multispecies: all collisions, or braginskii: self collisions and ie, source: /home/mike/work/cases/perftests/hermes-perftest/test4steady/BOUT.inp
