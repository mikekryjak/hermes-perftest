nout = 20000000            # number of writes
timestep = 95780 * 0.01          # 9578 is 1/10 of a milisecond

MZ = 1                  # points in z
NXPE = 1                # partitions in x

# Initial conditions
tnorm_setting = 1
#initial_te = 25 / tnorm_setting
initial_ti = 25 / tnorm_setting
initial_ne = 0.5e18 / hermes:Nnorm    # Nm-3
#initial_pe = initial_te * initial_ne
initial_pi = initial_ti * initial_ne

[input]
error_on_unused_options = false #true

[mesh]
file = "CDN_46895_260129_nowallpump_1e21.nc"             # Tokamak grid file, must be in same directory

[mesh:paralleltransform]                # Here be dragons *wrapping of field lines
type = shifted

#######################solver########################
# SNES-MUMPS-1
[solver]
diagnose = true
type = snes
snes_type = newtonls   # newtontr not as good
ksp_type = fgmres
pc_type = lu
max_nonlinear_iterations = 10
atol = 1e-7
rtol = 1e-6
stol = 1e-8
maxf = 2000
maxl = 260
matrix_free_operator = false
lag_jacobian = 1
timestep = 0.1

pid_controller = true
target_its = 100
kP = 0.233   # 0.65
kI = 0.133 # 0.30
kD = 0.0 # 0.15
# min_tstep_decrease = 0.5
# max_tstep_increase = 1.2

[petsc]
#snes_monitor
#snes_converged_reason
#ksp_converged_reason
log_view
snes_fd_color_use_mat
ksp_type = fgmres
pc_type = lu
pc_factor_mat_solver_type = mumps
snes_linesearch_type = basic

#######################solver########################
[hermes]
components = (d+, d, e, c,  braginskii_collisions, 
                braginskii_friction, braginskii_heat_exchange,braginskii_conduction,
                sheath_boundary_simple, recycling, sound_speed, reactions, electron_force_balance)                           # These are all we want

Nnorm = 1e+17  # Reference density [m^-3]                        # Keep as this for now
Bnorm = 1   # Reference magnetic field [T]
Tnorm = 1 #tnorm_setting   # Reference temperature [eV]
qe = 1.60218e-19
Mp = 1.67262e-27
Cs0 = sqrt(qe * Tnorm / Mp)
Omega_ci = qe * Bnorm / Mp
rho_s0 = Cs0 / Omega_ci


[braginskii_collisions]
diagnose = true
electron_electron = true
ion_ion = true
electron_ion = true
electron_neutral = false
ion_neutral = false             # double counting with CX if true
neutral_neutral = false

################################################################
# Ions

[d+]
type = evolve_density, evolve_momentum, evolve_pressure, anomalous_diffusion

AA = 2
charge = 1

thermal_conduction = true
#conduction_collisions_mode = braginskii
conduction_collisionality_mode = braginskii


kappa_limit_alpha = -1
eta_limit_alpha = -1
# Change to match david

recycle_as = d
target_recycle = true
target_recycle_multiplier = 0.99 #0.999
target_recycle_energy = 3.5

sol_recycle = false # true $ 260120 no sidewall pump
sol_recycle_multiplier = 0.99 #0.999
sol_recycle_energy = 3.5

pfr_recycle = false # true 260120 no sidewall pump
pfr_recycle_multiplier = 0.99 #0.999
pfr_recycle_energy = 3.5

neutral_pump = true # must be true as target still pump neutrals 260129
pump_recycle_multiplier = 0.99 #0.999

target_fast_recycle_energy_factor = 0.48        # Keep as same
target_fast_recycle_fraction = 0.8             # Keep as same

anomalous_nu = 2 # 0.2    ### change to davids
diagnose = true

[Nd+]

function = initial_ne                           # initial conditions (see above)
bndry_core = neumann
bndry_sol = neumann
bndry_pf = neumann    # Set to davids decay length unit is in m (DOUBLE check)
bndry_all = neumann   # All boundaries neumann  # Keep as neumann

[Pd+]

function = initial_pi
bndry_core = neumann
bndry_sol = neumann   # lambda q beyond the grid (ask David)
bndry_pf = neumann
bndry_all = neumann   # All boundaries neumann

# Core source
power_in = 0.5 # 0.3   # MW
core_volume = 0.29689 #0.17737   # m^3
pressure_source = power_in * 1e6 * 2/3 / core_volume
source = H(x) * H(0.035-x) * pressure_source #0.007 #0.071
source_only_in_core = true


################################################################
# Neutrals

[d]
type = neutral_mixed, neutral_boundary
evolve_momentum = true                  # make sure on
precondition = false   # currently preconditioner is not good
diffusion_collisions_mode = afn

# Added to match the ST40 branch
flux_limit = 1
neutral_lmax = 100


AA = 2
diagnose = true
#diagnose_eqns = true

output_ddt = true

neutral_boundary_sol = true
neutral_boundary_pfr = true
neutral_boundary_upper_y = true
neutral_boundary_lower_y = true

target_energy_refl_factor = 0.7                # how much energy is kept during fast reflection
sol_energy_refl_factor = 0.67
pfr_energy_refl_factor = 0.67

target_fast_refl_fraction = 0.8                # how likely to fast reflection (keep numbers same)
sol_fast_refl_fraction = 0.7
pfr_fast_refl_fraction = 0.7

kappa_limit_alpha = 1

[Pd]
bndry_sol = neumann  # This prevents advection of density or energy out of the SOL
bndry_core = neumann
bndry_all = neumann

[Nd]
bndry_sol = neumann
bndry_core = neumann
bndry_all = neumann

# These are defaults
##################
[Td]
bndry_sol = neumann
bndry_all = neumann

[Dnnd]
bndry_all = neumann

################################################################
# Electrons

[e]
# Set electron density from quasineutrality,
# and parallel flow from ion flow, assuming no currents
type = quasineutral, evolve_pressure, zero_current, anomalous_diffusion

AA = 1/1836
charge = -1
thermal_conduction = true
kappa_limit_alpha = -1 #0.3 # matches David now
diagnose = true
#conduction_collisions_mode = braginskii
conduction_collisionality_mode = braginskii


[Pe]
function = initial_pi
bndry_core = neumann
bndry_sol = neumann
bndry_pf = neumann
bndry_all = neumann   # All other boundaries low density

# Core source
power_in = 0.5 # 0.3   # MW
core_volume = 0.29689 #0.17737   # m^3
pressure_source = power_in * 1e6 * 2/3 / core_volume
source = H(x) * H(0.035-x) * pressure_source
source_only_in_core = true

################################################################

[c]
type = fixed_fraction_carbon
fraction = 0.0
no_core_radiation = true
diagnose = true   # Saves Rc (R + section name)

################################################################
[sheath_boundary_simple]
gamma_i = 2.5   # matches David now
gamma_e = 4.5   # matches David now



[recycling]

species = d+

[reactions]

diagnose = true

type = ( d + e -> d+ + 2e, d+ + e -> d, d + d+ -> d+ + d, )     # Deuterium ionisation  Deuterium recombination  Charge exchange
