# test6 -- ST40 low res test: low-res ST40, flux limit 1.0, separate limiters.
#
# Source: seplim series 24 rung d,
# /home/mike/work/cases/fluxlim/seplim/splim24d-st40lr_seplim-unifloor_nocombined_floor10_ratio40_flim1.0_scratch
# (separate limiters, floor 10, ratio 40, ceiling 100, Van Albada, from scratch).
# Changes from that input:
#   - nout = 100, timestep = 95788 (1 ms): the window is 0-100 ms. The source
#     used 0.6 * 98570, which ran to 123.5 ms, not 120.
#   - neutral density and pressure start non-zero (initial_nd, initial_td,
#     initial_pd, as test4), so scale_vars does not floor them.
#   - error_on_unused_options = true.
#   - grid renamed grid_test6.nc (the same file); run from the repo root.
# Everything else is as the source ran it, including its solver block
# (SNES-MUMPS-1 with target_its = 100). Each ladder row sets its own recipe;
# see readme.md.

nout = 100                     # Number of output timesteps
timestep = 95788        # 95788 = 1ms in normalised units

MZ = 1
NXPE = 1

####### NOTES
####### Target values: Te: 1450, Ti: 1745, Ne: 7.4e19
####### Target core diffusion: De = Di = 0.3, Chi_e = Chi_i = 0.45

####### CUSTOM INPUTS
# Actual temperature method
#core_te = 40 / hermes:Tnorm   # [eV]
#core_ti = 40 / hermes:Tnorm   # [eV]

# Tnorm scale method. Temp = core_te * tnorm_setting
tnorm_setting = 100

core_te = 1500 / tnorm_setting    # 1450
core_ti = 1500 / tnorm_setting    # 1745
core_ne = 7e19 / hermes:Nnorm    # Nm-3

initial_te = core_te * 0.1
initial_ti = core_ti * 0.1
initial_ne = core_ne * 1

initial_pe = initial_te * initial_ne
initial_pi = initial_ti * initial_ne
initial_nd = 1e16 / hermes:Nnorm   # 1e16 m^-3; non-zero so scale_vars does not floor it
initial_td = 3 / tnorm_setting     # 3 eV
initial_pd = initial_nd * initial_td

####### DERIVED FROM CUSTOM INPUTS
core_pi = core_ne * core_ti
core_pe = core_ne * core_te

# Below is set from grid now
# anomalous_D_i_core = anomalous_D_e_core    # Same as electrons
# anomalous_Chi_i_core = anomalous_Chi_e_core    # Same as electrons

[input]
error_on_unused_options = true

[mesh]

file = "grid_test6.nc"

# Geometry calculations for profiles
# This is adapted from https://bout-dev.readthedocs.io/en/latest/user_docs/variable_init.html#id4
# The index (i) is defined as excluding guards, hence I add "+ MXG" at the enabled
# Remember to manually change these numbers if you change grid!!!

xsep_inner = 19  # Last cell before separatrix (ixseps - 1)
nx = 40
MXG = 2
x_index = x*(nx - 2 * MXG) - 0.5 + MXG


[mesh:paralleltransform]
type = shifted

[solver]
diagnose_failures = true   # all failure blocks, not just the last
diagnose = true
type = snes
snes_type = newtonls   # newtontr not as good
ksp_type = fgmres
pc_type = lu
max_nonlinear_iterations = 10
atol = 1e-7
rtol = 1e-6
stol = 1e-12
maxf = 2000
maxl = 260
matrix_free_operator = false
lag_jacobian = 1
timestep = 0.1

timestep_control = pid_nonlinear_its   # was pid_controller = true (translated by apply_recipe.py)
target_its = 100
kP = 0.233   # 0.65
kI = 0.133 # 0.30
kD = 0.0 # 0.15
# min_tstep_decrease = 0.5
# max_tstep_increase = 1.2

[petsc]
# Standing campaign setting since 2026-08-13: without it a recoverable zero
# pivot becomes a fatal MUMPS INFOG(1)=-3 and reads as instability.
mat_mumps_icntl_24 = 1
#snes_monitor
#snes_converged_reason
#ksp_converged_reason
log_view
snes_fd_color_use_mat
ksp_type = fgmres
pc_type = lu
pc_factor_mat_solver_type = mumps
snes_linesearch_type = basic

[hermes]
components = (d+, d, e,
              sheath_boundary_simple, braginskii_collisions, braginskii_friction,
              braginskii_heat_exchange, reactions, electron_force_balance,
              braginskii_conduction, recycling)

Nnorm = 1e17  # Reference density [m^-3]
Bnorm = 1   # Reference magnetic field [T]
Tnorm = tnorm_setting   # Reference temperature [eV]
qe = 1.60218e-19
Mp = 1.67262e-27
Cs0 = sqrt(qe * Tnorm / Mp)
Omega_ci = qe * Bnorm / Mp
rho_s0 = Cs0 / Omega_ci

[braginskii_collisions]
diagnose = true
electron_electron = true
ion_ion = true
electron_ion = true

# EN
electron_neutral = false

# IN
ion_neutral = false

# NN
neutral_neutral = false

################################################################
# Ions

[d+]
type = evolve_density, evolve_momentum, evolve_pressure, anomalous_diffusion

AA = 2
charge = 1

thermal_conduction = true
kappa_limit_alpha = -1 # No flux limiter for ions
conduction_collisions_mode = braginskii

recycle_as = d
target_recycle = true
target_recycle_multiplier = 1
target_recycle_energy = 3.5

sol_recycle = true
sol_recycle_multiplier = 1
sol_recycle_energy = 3.5

pfr_recycle = true
pfr_recycle_multiplier = 1
pfr_recycle_energy = 3.5

neutral_pump = true
pump_recycle_multiplier = 0.990  #

target_fast_recycle_energy_factor = 0.48
target_fast_recycle_fraction = 0.80

anomalous_nu = 0.2
diagnose = true

[Nd+]

function = initial_ne
# bndry_core = dirichlet(core_ne) # Now there is a source
bndry_sol = decaylength(0.03 / hermes:rho_s0)
bndry_pf = decaylength(0.03 / hermes:rho_s0)
bndry_all = neumann   # All boundaries neumann

[Pd+]

function = initial_pi
# bndry_core = dirichlet(core_pi) # Now there is a source
bndry_sol = decaylength(0.03 / hermes:rho_s0)
bndry_pf = decaylength(0.03 / hermes:rho_s0)
bndry_all = neumann   # All boundaries neumann

################################################################
# Neutrals

[d]
type = neutral_mixed, neutral_boundary

# --- KNOWN DIFFERENCE NO SWITCH CONTROLS. Read before trusting an A/B. ------
# The switches are NOT the whole story. neutral-fluxlim-full also recomputes
# NVn = AA*Nn*Vn after the density floor, keeps NVn_err = NVn - NVn_solver,
# adds `ddt(NVn) += NVn_err`, and restores NVn_solver in finally().
# separate-neutral-fluxlim does none of that -- the term is absent from its base
# and from master, and no input option turns it on or off. It acts only where
# Nn < density_floor (1e-8 normalised), so the effect should be small, but it is
# a term in the time derivative of an evolved field and can move convergence and
# robustness, not just profiles. Porting it is fl-cvl.5.

# --- Limiter settings. IDENTICAL numbers and units in series 23 and 24. ------
# Both binaries now take the same option names in the same units, so these lines
# are byte-identical between the two series apart from the eta ceiling, where
# the two branches spell "off" differently.
flux_limit = 1.0
flux_limit_cond_perp = 1.0
flux_limit_cond_par = 1.0
flux_limit_visc_perp = 1.0
flux_limit_visc_par = 1.0
flux_limiter_sharpness = 1.0

combined_limiters = false  # each channel limited on its own gradient.
# lag_limiter absent from this branch -- see header.
neutral_lmax = 1.0                # [m]

# --- UNIFIED regularisation, rung d: ratiofix. ---------------------------------
limiter_gradient_floor = 10          # [1/m], perpendicular
limiter_gradient_floor_ratio = 40     # parallel floor = 10/40 = 0.25
limiter_gradient_ceiling = 100.0      # [1/m], shared, held across the ladder

AA = 2
diagnose = true
output_ddt = true
precondition = false

diffusion_collisions_mode = afn

neutral_boundary_sol = true
neutral_boundary_pfr = true
neutral_boundary_upper_y = true
neutral_boundary_lower_y = true

target_energy_refl_factor = 0.70
sol_energy_refl_factor = 0.67
pfr_energy_refl_factor = 0.67

target_fast_refl_fraction = 0.80
sol_fast_refl_fraction = 0.70
pfr_fast_refl_fraction = 0.70

[Pd]
function = initial_pd
bndry_sol = neumann  # This prevents advection of density or energy out of the SOL
bndry_core = free_o3  # This allows density and energy advection out of core
bndry_all = neumann

[Nd]
function = initial_nd
bndry_sol = neumann
bndry_core = free_o3  # This allows density and energy advection out of core
bndry_all = neumann

[Td]
bndry_sol = neumann
bndry_all = neumann

[Dnnd]
bndry_all = neumann

[DnnPnd]
bndry_all = neumann

[DnnTnd]
bndry_all = neumann

[DnnNnd]
bndry_all = neumann

################################################################
# Electrons

[e]
# Set electron density from quasineutrality,
# and parallel flow from ion flow, assuming no currents
type = quasineutral, evolve_pressure, zero_current, anomalous_diffusion

AA = 1/1836
charge = -1
thermal_conduction = true
kappa_limit_alpha = 0.2
conduction_collisions_mode = braginskii

anomalous_nu = 0.2
diagnose = true

[Pe]
function = initial_pi
# bndry_core = dirichlet(core_pi) # Now there is a source
bndry_sol = decaylength(0.03 / hermes:rho_s0)
bndry_pfr = decaylength(0.03 / hermes:rho_s0)
bndry_all = neumann   # All other boundaries low density

################################################################
[sheath_boundary_simple]
gamma_i = 2.5
gamma_e = 4.5

[recycling]

species = d+

[reactions]

diagnose = true

type = (
        d + e -> d+ + 2e,     # Deuterium ionisation
        d+ + e -> d,          # Deuterium recombination
        d + d+ -> d+ + d,     # Charge exchange
       )
